# Opcional no local. Sem isto o app usa file:sqlite.db na pasta do projeto.
SQLITE_DB_PATH=sqlite.db

# Vercel: deixe vazio para seed em memória (zero config).
# Persistência entre deploys: crie um banco Turso e preencha no dashboard:
# Settings → Environment Variables
# DATABASE_URL=libsql://seu-db.turso.io
# DATABASE_AUTH_TOKEN=
